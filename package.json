{
  "name": "@homebridge-plugins/homebridge-tuya",
  "displayName": "Homebridge Tuya (jdipper FastWarm)",
  "version": "2.7.2-jdipper.1",
  "private": true,
  "description": "jdipper's Homebridge Tuya fork with FastWarm room temperatures, household programmes and security fixes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jdipper/homebridge-tuya"
  },
  "homepage": "https://github.com/jdipper/homebridge-tuya#readme",
  "bugs": {
    "url": "https://github.com/jdipper/homebridge-tuya/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/tassy-h"
    }
  ],
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0",
    "node": "^20 || ^22 || ^24 || ^25"
  },
  "peerDependencies": {
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**/*.ts --max-warnings=0",
