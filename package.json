    "eslint": "8.57.1",
    "homebridge": "^2.0.0",
    "jest": "^29.1.2",
    "nodemon": "^3.1.10",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.3.0",
    "typescript": "^5.0.0"
